+                rec["numeric_" + mode] += sum(1 for v in flat.values() if isinstance(v, (int, float)) and not isinstance(v, bool))
+                rec["float_" + mode] += sum(1 for v in flat.values() if _is_float(v))
+                if mode == "totals":
