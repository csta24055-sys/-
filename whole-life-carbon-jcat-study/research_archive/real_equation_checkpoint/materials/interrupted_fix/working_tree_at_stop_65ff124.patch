+    """Literal definition: n = 1, 2, ... while n*period < T*c; the event belongs to year max(1, ceil(n*period*c))."""
+    limit = Fraction(T) * C
+    step = Fraction(period)
+    years = []
+    n = 1
+    while n * step < limit:
+        years.append(max(1, math.ceil(n * step * C)))
+        n += 1
+    return years
