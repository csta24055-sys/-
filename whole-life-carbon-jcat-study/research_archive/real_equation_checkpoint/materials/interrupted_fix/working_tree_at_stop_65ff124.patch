+
+    def counting(original):
+        def wrapper(*a):
+            calls["n"] += 1
+            return original(*a)
+        return wrapper
+
+    original = engine._purchased_series
+    engine._purchased_series = counting(original)
+    try:
+        engine.evaluate(scn, detail=False)
