{"claim_id": "CLM-C02-0019", "company_id": "COMPANY_02", "axis_id": "AXIS_02", "topic_id": "AXIS_02_T02", "question_id": "Q-C02-A02-T02-02", "claim_type": "FACT", "statement": "FY2025（2026年3月期）の当社所有者に帰属する当期純利益（百万円）は、地球環境エネルギー160,862、マテリアルソリューション26,348、金属資源204,523、社会インフラ85,124、モビリティ57,609、食品産業83,257、S.L.C. 91,007、電力ソリューション43,408で、8セグメント合計752,138にその他51,776と調整・消去△3,454を加え連結800,460（前期950,709）。", "evidence": [{"passage_id": "PSG-C02-0037", "direction": "SUPPORT", "relation": "PRIMARY_DIRECT"}, {"passage_id": "PSG-C02-0038", "direction": "SUPPORT", "relation": "PRIMARY_DIRECT"}, {"passage_id": "PSG-C02-0039", "direction": "SUPPORT", "relation": "PRIMARY_DIRECT"}], "valid_from": null, "valid_to": null, "validity": "HISTORICAL_IMMUTABLE", "info_class": "AUDITED_FINANCIAL", "snapshot": "asof_2026-11-01", "notes": "", "recorded_at": "2026-11-10T21:18:43+09:00"}
