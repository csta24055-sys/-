{
  "version": 1,
  "entry_skill": "career-model-router",
  "stages": [
    {
      "id": "master_plan",
      "agent": "career-strategy-architect",
      "model": "claude-fable-5-2",
      "effort": "high",
      "next": "source_research"
    },
    {
      "id": "source_research",
      "agent": "career-evidence-researcher",
      "model": "claude-opus-5-5",
      "effort": "medium",
      "next": "artifact_build"
    },
    {
      "id": "artifact_build",
      "agent": "career-artifact-builder",
      "model": "claude-opus-5-5",
      "effort": "high",
      "next": "gpt_handoff"
    },
    {
      "id": "gpt_handoff",
      "agent": "career-gpt-handoff",
      "model": "claude-opus-5-5",
      "effort": "high",
      "next": "post_gpt_plan"
    },
    {
      "id": "post_gpt_plan",
      "agent": "career-replan-director",
      "model": "claude-fable-5-2",
      "effort": "high",
      "next": "source_research"
    }
  ],
  "stop_conditions": [
    "review_pass_and_accepted",
    "manual_stop",
    "authorization_or_budget_limit",
    "missing_model_access",
    "unresolvable_blocker"
  ],
  "gpt_review": {
    "existing_skill": "gpt-consult",
    "existing_loop": "judgment-loop",
    "bypass_approvals": false,
    "require_real_response_before_claiming_success": true
  },
  "privacy": {
    "public_repo_code_only": true,
    "private_home_environment_variable": "JUDGMENT_LOOP_HOME"
  }
}
